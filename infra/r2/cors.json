{
  "rules": [
    {
      "allowed": {
        "origins": ["https://www.familyclinic.doctor", "http://localhost:8080"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Accept-Ranges", "Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
