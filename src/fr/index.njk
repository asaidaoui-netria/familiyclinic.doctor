---
layout: layouts/base.njk
locale: fr
pageKey: home
permalink: /fr/index.html
activeNav: home
indexable: true
stylesheets: [styles.css, localization.css]
scripts: [script.js, localization.js]
title: "Family Clinic - Soins de santé complets pour votre famille"
description: "Family Clinic offre des services de santé complets pour tous les âges. Notre équipe expérimentée propose des soins personnalisés dans un environnement accueillant."
---

        <!-- Hero Section -->
        <section class="hero">
            <div class="hero__container">
                <div class="hero__content">
                    <h2 class="hero__title">Soins de santé complets pour votre famille</h2>
                    <p class="hero__description">
                        Découvrez des soins personnalisés dans un environnement accueillant. Notre équipe expérimentée
                        offre des services de santé complets pour les patients de tous âges.
                    </p>
                    <div class="hero__actions">
                        <a href="contact.html" class="btn btn--primary">Prendre rendez-vous</a>
                    </div>
                </div>
                <div class="hero__image">
                    <img src="../assets/images/optimized/clinic/clinic_entrance_desktop_800x400.jpg"
                        srcset="../assets/images/optimized/clinic/clinic_entrance_mobile_600x300.jpg 600w, ../assets/images/optimized/clinic/clinic_entrance_desktop_800x400.jpg 800w"
                        sizes="(max-width: 768px) 100vw, 50vw"
                        alt="Entrée de la Family Clinic avec établissement de santé moderne" class="hero__img"
                        loading="lazy" onerror="this.style.display='none'">
                </div>
            </div>
        </section>

        <!-- Services Preview Section -->
        <section class="services-preview">
            <div class="services-preview__container">
                <h2 class="services-preview__title">Nos Services</h2>
                <p class="services-preview__subtitle">Solutions de santé complètes combinant approches traditionnelles
                    et holistiques</p>

                <div class="services-preview__grid">
                    <!-- First Row: 3 cards -->
                    <div class="service-card">
                        <div class="service-card__icon">
                            <img src="../assets/images/optimized/services/primary_care_icon_desktop_160x160.jpg"
                                alt="Icône Médecine de famille" class="service-card__icon-img" loading="lazy"
                                onerror="this.style.display='none'">
                        </div>
                        <h3 class="service-card__title">Médecine de famille</h3>
                        <p class="service-card__description">
                            Au cœur de chaque famille, la santé est un lien essentiel. Soins de santé familiaux complets
                            avec suivi médical personnalisé, prévention et relations de confiance pour tous les âges.
                        </p>
                        <a href="{{ 'services' | localizedUrl(locale) }}#{{ site.serviceAnchors[locale][0] }}" class="service-card__link">En savoir plus</a>
                    </div>

                    <div class="service-card">
                        <div class="service-card__icon">
                            <img src="../assets/images/optimized/services/holistic_consultation_desktop_800x400.jpg"
                                srcset="../assets/images/optimized/services/holistic_consultation_mobile_600x300.jpg 600w, ../assets/images/optimized/services/holistic_consultation_desktop_800x400.jpg 800w"
                                sizes="(max-width: 768px) 600px, 800px" alt="Icône Consultations holistiques"
                                class="service-card__icon-img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="service-card__title">Consultations holistiques</h3>
                        <p class="service-card__description">
                            Prenez soin de vous autrement. Explorez une approche globale de la santé qui prend en compte
                            le corps, l'esprit et l'émotion.
                        </p>
                        <a href="{{ 'services' | localizedUrl(locale) }}#{{ site.serviceAnchors[locale][1] }}" class="service-card__link">En savoir plus</a>
                    </div>

                    <div class="service-card">
                        <div class="service-card__icon">
                            <img src="../assets/images/optimized/services/quantum_scan_desktop_800x400.jpg"
                                srcset="../assets/images/optimized/services/quantum_scan_mobile_600x300.jpg 600w, ../assets/images/optimized/services/quantum_scan_desktop_800x400.jpg 800w"
                                sizes="(max-width: 768px) 600px, 800px" alt="Icône Quantum Scan"
                                class="service-card__icon-img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="service-card__title">Quantum Scan</h3>
                        <p class="service-card__description">
                            "Le corps parle en fréquences : écoutons-le." Explorez votre santé autrement grâce au
                            Quantum Scan.
                            Technologie bioénergétique avancée qui analyse les déséquilibres internes.
                        </p>
                        <a href="{{ 'services' | localizedUrl(locale) }}#{{ site.serviceAnchors[locale][2] }}" class="service-card__link">En savoir plus</a>
                    </div>

                    <!-- Second Row: 3 cards -->
                    <div class="service-card">
                        <div class="service-card__icon">
                            <img src="../assets/images/optimized/services/naturopathy_desktop_800x400.jpg"
                                srcset="../assets/images/optimized/services/naturopathy_mobile_600x300.jpg 600w, ../assets/images/optimized/services/naturopathy_desktop_800x400.jpg 800w"
                                sizes="(max-width: 768px) 600px, 800px" alt="Icône Naturopathie"
                                class="service-card__icon-img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="service-card__title">Naturopathie</h3>
                        <p class="service-card__description">
                            Redécouvrez votre équilibre naturellement. Offrez à votre corps ce qu'il mérite :
                            une approche qui nourrit, soigne et revitalise.
                        </p>
                        <a href="{{ 'services' | localizedUrl(locale) }}#{{ site.serviceAnchors[locale][3] }}" class="service-card__link">En savoir plus</a>
                    </div>

                    <div class="service-card">
                        <div class="service-card__icon">
                            <img src="../assets/images/optimized/services/vaccum_cupping_desktop_800x400.jpg"
                                srcset="../assets/images/optimized/services/vaccum_cupping_mobile_600x300.jpg 600w, ../assets/images/optimized/services/vaccum_cupping_desktop_800x400.jpg 800w"
                                sizes="(max-width: 768px) 600px, 800px" alt="Icône Hijamah"
                                class="service-card__icon-img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="service-card__title">Hijamah</h3>
                        <p class="service-card__description">
                            Découvrez les bienfaits de la hijamah, une méthode thérapeutique traditionnelle reconnue
                            pour ses vertus purifiantes et revitalisantes.
                        </p>
                        <a href="{{ 'services' | localizedUrl(locale) }}#{{ site.serviceAnchors[locale][4] }}" class="service-card__link">En savoir plus</a>
                    </div>

                    <div class="service-card">
                        <div class="service-card__icon">
                            <img src="../assets/images/optimized/services/physiotherapy_desktop_800x400.jpg"
                                srcset="../assets/images/optimized/services/physiotherapy_mobile_600x300.jpg 600w, ../assets/images/optimized/services/physiotherapy_desktop_800x400.jpg 800w"
                                sizes="(max-width: 768px) 600px, 800px" alt="Icône Physiothérapie"
                                class="service-card__icon-img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="service-card__title">Physiothérapie</h3>
                        <p class="service-card__description">
                            Soulagez vos douleurs, améliorez votre mobilité. Retrouvez le confort au quotidien
                            grâce à notre service de physiothérapie.
                        </p>
                        <a href="{{ 'services' | localizedUrl(locale) }}#{{ site.serviceAnchors[locale][5] }}" class="service-card__link">En savoir plus</a>
                    </div>

                    <!-- Third Row: 3 cards -->
                    <div class="service-card">
                        <div class="service-card__icon">
                            <img src="../assets/images/optimized/services/dermatology_desktop_800x400.jpg"
                                srcset="../assets/images/optimized/services/dermatology_mobile_600x300.jpg 600w, ../assets/images/optimized/services/dermatology_desktop_800x400.jpg 800w"
                                sizes="(max-width: 768px) 600px, 800px" alt="Icône Dermatologie"
                                class="service-card__icon-img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="service-card__title">Dermatologie & chirurgie intégrative</h3>
                        <p class="service-card__description">
                            Pour une peau rayonnante, naturellement. Nous associons les soins dermatologiques
                            classiques à la naturopathie pour une peau saine.
                        </p>
                        <a href="{{ 'services' | localizedUrl(locale) }}#{{ site.serviceAnchors[locale][6] }}" class="service-card__link">En savoir plus</a>
                    </div>

                    <div class="service-card">
                        <div class="service-card__icon">
                            <img src="../assets/images/optimized/services/judiciary_medical_expertise_desktop_800x533.jpg"
                                srcset="../assets/images/optimized/services/judiciary_medical_expertise_mobile_600x400.jpg 600w, ../assets/images/optimized/services/judiciary_medical_expertise_desktop_800x533.jpg 800w"
                                sizes="(max-width: 768px) 600px, 800px"
                                alt="Expertise médicale judiciaire - Marteau professionnel représentant l'expertise médicale légale"
                                class="service-card__icon-img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="service-card__title">Expertise médicale judiciaire</h3>
                        <p class="service-card__description">
                            Expertise médicale professionnelle pour les procédures légales et judiciaires.
                            Services de témoin expert et rapports médicaux complets pour les affaires judiciaires.
                        </p>
                        <a href="{{ 'services' | localizedUrl(locale) }}#{{ site.serviceAnchors[locale][7] }}" class="service-card__link">En savoir
                            plus</a>
                    </div>

                    <div class="service-card">
                        <div class="service-card__icon">
                            <img src="../assets/images/optimized/services/weight_loss_desktop_800x533.jpg"
                                srcset="../assets/images/optimized/services/weight_loss_mobile_600x399.jpg 600w, ../assets/images/optimized/services/weight_loss_desktop_800x533.jpg 800w"
                                sizes="(max-width: 768px) 600px, 800px"
                                alt="Perte de poids - Céleri frais avec mètre ruban représentant la gestion du poids santé"
                                class="service-card__icon-img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="service-card__title">Perte de poids</h3>
                        <p class="service-card__description">
                            Programmes complets de gestion du poids combinant expertise médicale avec conseils
                            nutritionnels personnalisés et orientation lifestyle pour des résultats durables.
                        </p>
                        <a href="{{ 'services' | localizedUrl(locale) }}#{{ site.serviceAnchors[locale][8] }}" class="service-card__link">En savoir plus</a>
                    </div>
                </div>

                <div class="services-preview__cta">
                    <a href="services.html" class="btn btn--primary">Voir tous les services</a>
                </div>
            </div>
        </section>

        <!-- About Preview Section -->
        <section class="about-preview">
            <div class="about-preview__container">
                <div class="about-preview__content">
                    <h2 class="about-preview__title">À propos de notre clinique</h2>
                    <p class="about-preview__description">
                        Family Clinic incarne une nouvelle façon de vivre la santé : humaine, intégrative et tournée
                        vers l'avenir.
                        Nous mettons l'accent sur une médecine personnalisée et bienveillante, adaptée aux besoins réels
                        des familles.
                    </p>
                    <p class="about-preview__description">
                        Notre approche combine expertise médicale, écoute active et ouverture multiculturelle pour
                        garantir
                        une prise en charge de qualité, accessible à tous.
                    </p>
                    <a href="about.html" class="btn btn--secondary">En savoir plus sur nous</a>
                </div>
                <div class="about-preview__image">
                    <img src="../assets/images/optimized/clinic/about_clinic_desktop_800x400.jpg"
                        srcset="../assets/images/optimized/clinic/about_clinic_mobile_600x300.jpg 600w, ../assets/images/optimized/clinic/about_clinic_desktop_800x400.jpg 800w"
                        sizes="(max-width: 768px) 100vw, 50vw"
                        alt="Professionnels de santé dans un environnement clinique moderne" class="about-preview__img"
                        loading="lazy" onerror="this.style.display='none'">
                </div>
            </div>
        </section>

        <!-- Team Preview Section -->
        <section class="team-preview">
            <div class="team-preview__container">
                <h2 class="team-preview__title">Rencontrez notre équipe</h2>
                <p class="team-preview__subtitle">Professionnels de santé expérimentés dédiés à la santé de votre
                    famille</p>

                <div class="team-preview__grid">
                    <div class="team-member">
                        <div class="team-member__photo">
                            <img src="../assets/images/optimized/team/dr_my_abdellah_desktop_400x400.png"
                                srcset="../assets/images/optimized/team/dr_my_abdellah_mobile_300x300.png 300w, ../assets/images/optimized/team/dr_my_abdellah_desktop_400x400.png 400w"
                                sizes="(max-width: 768px) 300px, 400px"
                                alt="Dr. Said-Alaoui Moulay Abdellah - Médecin de famille" class="team-member__img"
                                loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="team-member__name">Dr. Said-Alaoui Moulay Abdellah</h3>
                        <p class="team-member__title">Médecin de famille</p>
                        <p class="team-member__description">
                            Médecin de famille certifié avec plus de 40 ans d'expérience dans les soins familiaux
                            complets.
                        </p>
                    </div>

                    <div class="team-member">
                        <div class="team-member__photo">
                            <img src="../assets/images/optimized/team/nurse_safae_desktop_400x400.png"
                                srcset="../assets/images/optimized/team/nurse_safae_mobile_300x300.png 300w, ../assets/images/optimized/team/nurse_safae_desktop_400x400.png 400w"
                                sizes="(max-width: 768px) 300px, 400px" alt="Mme Imarhrane Safae - Infirmière diplômée"
                                class="team-member__img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <h3 class="team-member__name">Mme Imarhrane Safae</h3>
                        <p class="team-member__title">Infirmière diplômée</p>
                        <p class="team-member__description">
                            Infirmière expérimentée spécialisée dans les soins aux patients et l'éducation à la santé.
                        </p>
                    </div>
                </div>

                <div class="team-preview__cta">
                    <a href="about.html#team" class="btn btn--secondary">Rencontrer toute notre équipe</a>
                </div>
            </div>
        </section>
