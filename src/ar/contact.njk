---
layout: layouts/base.njk
locale: ar
pageKey: contact
permalink: /ar/contact.html
activeNav: contact
indexable: true
stylesheets: [styles.css, contact.css, localization.css]
scripts: [script.js, contact.js, localization.js]
title: "تواصل معنا - عيادة الأسرة | ابق على تواصل"
description: "اتصل بعيادة الأسرة للمواعيد والاستفسارات أو الأسئلة العامة في القنيطرة، المغرب."
---

        <!-- Contact Hero Section -->
        <section class="contact-hero">
            <div class="container">
                <div class="contact-hero__content">
                    <h1 class="contact-hero__title">ابق على تواصل</h1>
                    <p class="contact-hero__description">
                        نحن هنا لمساعدتك وعائلتك. اتصل بنا للمواعيد أو الأسئلة أو لمعرفة المزيد عن خدمات الرعاية الصحية
                        الشاملة لدينا.
                    </p>
                </div>
            </div>
        </section>

        <!-- Notice Banner Section -->
        <!-- <section class="notice-banner" id="notice-banner">
            <div class="notice-banner__container">
                <div class="notice-banner__content">
                    <div class="notice-banner__text">
                        <h3 class="notice-banner__title">إشعار مهم</h3>
                        <p class="notice-banner__message">
                            ستكون العيادة مغلقة من <strong>4 أغسطس</strong> حتى <strong>24 أغسطس</strong>
                            لقضاء إجازة الصيف السنوية.
                        </p>
                    </div>
                </div>
            </div>
        </section> -->

        <!-- Contact Information Section -->
        <section class="contact-info">
            <div class="contact-info__container">
                {% include "contact-details.njk" %}
            </div>
        </section>

        <!-- Map Section -->
        <section class="map-section">
            <div class="map-section__container">
                <h3 class="map-section__title">ابحث عنا</h3>
                <div class="map-section__content">
                    <div class="map-section__map">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d401.43216058873656!2d-6.621467983204455!3d34.26471722551217!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xda7590b1fc37cd3%3A0x7ce3ec2840772cca!2z2LnZitin2K_YqSDYp9mE2KPYs9ix2Kk!5e0!3m2!1sen!2sma!4v1754830762622!5m2!1sen!2sma"
                            width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade" title="خريطة موقع عيادة الأسرة">
                        </iframe>
                    </div>
                    <div class="map-section__info">
                        <h4 class="map-section__info-title">الوصول إلى هنا</h4>
                        <p class="map-section__info-text">
                            نحن موجودون في حي أولاد أوجيه في القنيطرة، بالقرب من مسجد الريان، ويمكن الوصول إلينا بسهولة
                            بالسيارة أو وسائل النقل العمومي أو سيراً على الأقدام.
                        </p>
                        <div class="map-section__directions">
                            <h5 class="map-section__directions-title">الاتجاهات</h5>
                            <ul class="map-section__directions-list">
                                <li>من محطة قطار القنيطرة: 14 دقيقة بالسيارة</li>
                                <li>الحافلة العمومية: الخطوط 5، 12، 14، و 16</li>
                                <li>موقف السيارات: موقف مجاني في الشارع. مساحة محدودة متاحة.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="faq-section">
            <div class="faq-section__container">
                <h3 class="faq-section__title">الأسئلة الشائعة</h3>
                <div class="faq-section__list">
                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            كيف يمكنني حجز موعد؟
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>يمكنك حجز موعد عن طريق الاتصال بنا على {{ site.contact.phone }} أو زيارتنا شخصياً خلال ساعات
                                العمل.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            ما هي الوثائق التي يجب أن أحضرها في زيارتي الأولى؟
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>يرجى إحضار بطاقة الهوية وأي سجلات طبية سابقة وقائمة الأدوية الحالية ومعلومات التأمين إن
                                أمكن.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            هل تقبلون المرضى بدون موعد؟
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>نعم، نقبل المرضى بدون موعد. ومع ذلك، ننصح بحجز موعد لضمان التوفر.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            ما هي اللغات التي تتحدثون بها؟
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>فريقنا يتحدث العربية والفرنسية والإنجليزية لضمان التواصل الواضح مع جميع مرضانا.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            هل يتوفر موقف للسيارات؟
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>نعم، لدينا موقف مجاني في الشارع. يرجى ملاحظة أن المواقف محدودة وقد تخضع للتوفر.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            هل العيادة مناسبة للكراسي المتحركة؟
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>نعم، العيادة مناسبة للكراسي المتحركة.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
