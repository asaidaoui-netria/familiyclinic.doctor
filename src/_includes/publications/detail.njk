{% set copy = site.locales[publicationPage.locale].publications %}
{% set publication = publicationPage.publication %}
{% set edition = publicationPage.edition %}
{% set fullSizeMb = (edition.assets.full.size / 1000000) | round(1) %}
<article class="publication-detail">
  <div class="container">
    <header class="publication-detail__header">
      <div class="publication-detail__cover">
        <img src="{{ edition.assets.cover.url }}" alt="{{ edition.title }}" width="{{ edition.assets.cover.width }}" height="{{ edition.assets.cover.height }}">
      </div>
      <div class="publication-detail__introduction">
        <p class="publication-detail__category">{{ copy.filters[publication.category] }}</p>
        <h1>{{ edition.title }}</h1>
        <p class="publication-detail__author">{{ copy.by }} {{ publication.author }}</p>
        <p class="publication-detail__summary">{{ edition.summary }}</p>
        <p class="publication-detail__description">{{ edition.description }}</p>
        <p class="publication-detail__metadata">
          <span>{{ copy.language }}: {{ site.localeNames[publicationPage.locale] }}</span>
          <span>{{ edition.assets.full.pageCount }} {{ copy.pageCount }}</span>
          <span>{{ copy.pdfFormat }} · {{ fullSizeMb }} MB</span>
        </p>
      </div>
    </header>

    <section class="publication-viewer" data-publication-viewer data-preview-url="{{ edition.assets.preview.url }}" data-preview-pages="{{ edition.assets.preview.pageCount }}" data-text-layer="{{ edition.assets.textLayer }}" aria-labelledby="publication-preview-heading">
      <div class="publication-viewer__heading">
        <p>{{ copy.preview }}</p>
        <h2 id="publication-preview-heading">{{ edition.title }}</h2>
      </div>
      <div class="publication-viewer__toolbar" role="toolbar" aria-label="{{ copy.preview }}">
        <div class="publication-viewer__pagination">
          <button type="button" data-viewer-previous aria-label="{{ copy.previousPage }}" disabled><span aria-hidden="true">←</span></button>
          <p class="publication-viewer__page-count" aria-live="polite">
            <span class="visually-hidden">{{ copy.page }}</span>
            <span data-viewer-page>1</span> {{ copy.of }} <span data-viewer-pages>{{ edition.assets.preview.pageCount }}</span>
          </p>
          <button type="button" data-viewer-next aria-label="{{ copy.nextPage }}" disabled><span aria-hidden="true">→</span></button>
        </div>
        <div class="publication-viewer__tools">
          <button type="button" data-viewer-zoom-out aria-label="{{ copy.zoomOut }}" disabled><span aria-hidden="true">−</span></button>
          <button type="button" data-viewer-zoom-in aria-label="{{ copy.zoomIn }}" disabled><span aria-hidden="true">+</span></button>
          <button type="button" data-viewer-fullscreen aria-label="{{ copy.fullscreen }}" disabled><span aria-hidden="true">⛶</span></button>
        </div>
      </div>
      <div class="publication-viewer__stage" data-viewer-stage>
        <p class="publication-viewer__status" data-viewer-status role="status">{{ copy.loadingPreview }}</p>
        <div class="publication-viewer__page" data-viewer-page-container>
          <canvas data-pdf-canvas aria-label="{{ copy.preview }}"></canvas>
          <div class="textLayer" data-pdf-text-layer></div>
        </div>
        <div class="publication-viewer__error" data-viewer-error role="alert" hidden>
          <p>{{ copy.previewUnavailable }}</p>
          <a href="{{ edition.assets.preview.url }}">{{ copy.openPreview }}</a>
        </div>
        <noscript><a href="{{ edition.assets.preview.url }}">{{ copy.openPreview }}</a></noscript>
      </div>
    </section>

    <div class="publication-detail__download">
      <a class="publication-detail__read" href="{{ edition.assets.full.url }}" download="{{ edition.assets.full.filename }}" aria-label="{{ copy.readNow }} — {{ edition.title }}, {{ copy.pdfFormat }}, {{ copy.downloadSize }} {{ fullSizeMb }} MB">
        <span>{{ copy.readNow }}</span>
        <span>{{ copy.pdfFormat }} · {{ fullSizeMb }} MB</span>
      </a>
    </div>

    <p class="publication-detail__disclaimer">{{ copy.educationalDisclaimer }}</p>
  </div>
</article>
