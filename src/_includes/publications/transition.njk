<section class="publication-heading publication-transition"><h1>{{ p.title | publicationText(p.locale) | safe }}</h1><p class="publication-intro">{{ p.description | publicationText(p.locale) | safe }}</p><div class="publication-transition-links">{% if p.availableRoutes.en %}<a href="{{ p.availableRoutes.en }}" lang="en">{{ pc.english }}</a>{% endif %}{% if p.availableRoutes.fr %}<a href="{{ p.availableRoutes.fr }}" lang="fr">{{ pc.french }}</a>{% endif %}</div></section>
