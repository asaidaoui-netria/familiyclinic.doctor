<!DOCTYPE html>
{% if pagination and pagination.items %}
  {% set publicationPage = pagination.items[0] %}
{% endif %}
{% if publicationPage %}
  {% set locale = publicationPage.locale %}
  {% set title = publicationPage.edition.title + " - Family Clinic" %}
  {% set description = publicationPage.edition.summary %}
  {% set localizedRoutes = publicationPage.localizedRoutes %}
{% endif %}
<html lang="{{ locale }}"{% if locale == "ar" %} dir="rtl"{% endif %}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script>
    (function () {
      try {
        var rootPages = { "/": "index.html", "/index.html": "index.html", "/about.html": "about.html", "/services.html": "services.html", "/contact.html": "contact.html" };
        var file = rootPages[window.location.pathname];
        if (!file) return;
        if (sessionStorage.getItem("langAutoDetected") || localStorage.getItem("userLanguageChoice") || localStorage.getItem("autoDetectDisabled")) return;
        var supported = { en: "en", fr: "fr", ar: "ar" };
        var languages = navigator.languages || [navigator.language || ""];
        var detected = null;
        for (var i = 0; i < languages.length; i++) {
          detected = supported[languages[i]] || supported[String(languages[i]).split("-")[0]];
          if (detected) break;
        }
        sessionStorage.setItem("langAutoDetected", "true");
        if (detected && detected !== "en") {
          window.location.replace("/" + detected + "/" + file);
        }
      } catch (error) {
        /* language storage unavailable */
      }
    })();
  </script>
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% set pageRoutes = localizedRoutes or site.routes[pageKey] %}
  {% set currentRoute = pageRoutes[locale] %}
  <link rel="canonical" href="{{ site.url }}{{ currentRoute }}">
  {% if pageRoutes %}
    {% for alternateLocale, alternateRoute in pageRoutes %}
  <link rel="alternate" hreflang="{{ alternateLocale }}" href="{{ site.url }}{{ alternateRoute }}">
    {% endfor %}
    {% if pageRoutes.en %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ pageRoutes.en }}">
    {% endif %}
  {% endif %}
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ currentRoute }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.locales[locale].clinicName }}">
  <meta property="og:locale" content="{{ site.ogLocales[locale] }}">
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
  {% if not indexable %}
  <meta name="robots" content="noindex, follow">
  {% endif %}
  <script defer data-domain="{{ site.analyticsDomain }}" src="https://plausible.io/js/script.hash.outbound-links.js"></script>
  <script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
  {% include "structured-data.njk" %}
  {% for stylesheet in stylesheets %}
  <link rel="stylesheet" href="/assets/{{ stylesheet }}">
  {% endfor %}
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
  <link rel="manifest" href="/assets/favicon/site.webmanifest">
</head>
<body>
  <a href="#main-content" class="skip-link">{{ site.locales[locale].skipToContent }}</a>
  {% include "header.njk" %}
  <main class="main" id="main-content">{{ content | safe }}</main>
  {% include "footer.njk" %}
  {% for script in scripts %}
  <script src="/assets/{{ script }}"></script>
  {% endfor %}
  {% for moduleScript in moduleScripts %}
  <script type="module" src="/assets/{{ moduleScript }}"></script>
  {% endfor %}
</body>
</html>
