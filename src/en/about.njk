---
layout: layouts/base.njk
locale: en
pageKey: about
permalink: /about.html
activeNav: about
indexable: true
stylesheets: [styles.css, about.css, localization.css]
scripts: [script.js, localization.js]
title: "About Us - Family Clinic | Comprehensive Healthcare in Kenitra"
description: "Learn about Family Clinic's mission to provide comprehensive healthcare services. Meet our experienced team of healthcare professionals dedicated to your family's health."
---

        <!-- Hero Section -->
        <section class="hero">
            <div class="hero__container">
                <div class="hero__content">
                    <p class="hero__eyebrow">ABOUT THE CLINIC</p>
                    <h1 class="hero__title">About Family Clinic</h1>
                    <p class="hero__description">
                        "The care that brings us together" - Discover our mission to provide comprehensive healthcare
                        that combines medical expertise with a human, integrative, and future-oriented approach.
                    </p>
                    <div class="hero__actions">
                        <a href="tel:{{ site.contact.phone }}" class="btn btn--primary">{{ site.locales[locale].cta.heroCall }}</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Clinic Section -->
        <section class="about-clinic">
            <div class="about-clinic__container">
                <h2 class="about-clinic__title">Our Mission & Vision</h2>
                <div class="about-clinic__content">
                    <div class="about-clinic__text">
                        <p class="about-clinic__description">
                            Family Clinic embodies a new way of experiencing health: human, integrative, and
                            future-oriented.
                            We emphasize personalized and compassionate medicine, adapted to the real needs of families.
                            Our approach combines medical expertise, active listening, and multicultural openness to
                            ensure
                            quality care accessible to all.
                        </p>

                        <div class="about-clinic__features">
                            <div class="about-clinic__feature">
                                <h3><span class="feature-chip" aria-hidden="true">🌿</span>Holistic Vision</h3>
                                <p>Our services encompass general medicine, specialized care, prevention, and global
                                    wellness.
                                    Each patient is supported in all dimensions of their health, both physical and
                                    mental.</p>
                            </div>

                            <div class="about-clinic__feature">
                                <h3><span class="feature-chip" aria-hidden="true">🌍</span>Multilingual Welcome</h3>
                                <p>Family Clinic serves a diverse community. Our team speaks multiple languages to
                                    create
                                    a care relationship based on trust and understanding.</p>
                            </div>

                            <div class="about-clinic__feature">
                                <h3><span class="feature-chip" aria-hidden="true">🎯</span>Our Commitment</h3>
                                <p>Making every consultation a human, accessible, and professional experience. Because
                                    "The care that brings together" is not just a slogan: it's our promise.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Team Section -->
        <section id="team" class="team">
            <div class="team__container">
                <h2 class="team__title">Meet Our Team</h2>
                <p class="team__subtitle">Experienced healthcare professionals dedicated to your family's health and
                    wellness</p>

                <div class="team__grid">
                    <div id="dr-said-alaoui" class="team-member team-member--detailed">
                        <div class="team-member__photo">
                            <img src="assets/images/optimized/team/dr_my_abdellah_desktop_400x400.png" width="400" height="400"
                                srcset="assets/images/optimized/team/dr_my_abdellah_mobile_300x300.png 300w, assets/images/optimized/team/dr_my_abdellah_desktop_400x400.png 400w"
                                sizes="(max-width: 768px) 300px, 400px"
                                alt="Dr. Said-Alaoui Moulay Abdellah - Family Medicine Physician"
                                class="team-member__img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <div class="team-member__info">
                            <h3 class="team-member__name">Dr. Said-Alaoui Moulay Abdellah</h3>
                            <p class="team-member__title">Family Medicine Physician</p>
                            <div class="team-member__description">
                                <p>
                                    Dr. Said-Alaoui Moulay Abdellah is a former military physician with over 40 years of
                                    experience at all levels of medical support, both national and international. As a
                                    family
                                    physician, he focuses on preventing lifestyle-related diseases. His experience with
                                    patients
                                    has given him sufficient perspective to understand the multitude of health problems
                                    that
                                    modern medicine still faces.
                                </p>
                                <p>
                                    By focusing on the nutritional and environmental causes of disease and what has
                                    become
                                    nutritional therapy, his approach is to provide patients, both healthy and sick,
                                    with clear
                                    scientific messages. He seeks to expand his patients' knowledge by helping them
                                    understand
                                    the causes of their illnesses. The nutritional advice he provides is thus easier to
                                    follow,
                                    and patients regularly report impressive and often rapid results.
                                </p>
                                <p>
                                    In doing so, he opens new perspectives for patients by powerfully contributing to
                                    what
                                    Hippocrates declared: "Let food be your medicine before your medicines become your
                                    food."
                                    Although questioning eating habits can sometimes be difficult to follow, patients
                                    respond
                                    positively to the natural care offered, whether preventive for healthy people or
                                    curative
                                    for people suffering from chronic diseases.
                                </p>
                                <p>
                                    By eliminating toxic and disease-causing foods, within a few days, life resumes its
                                    course,
                                    and it is precisely the attentive follow-up that often produces unexpected results.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="team-member team-member--detailed">
                        <div class="team-member__photo">
                            <img src="assets/images/optimized/team/nurse_safae_desktop_400x400.png" width="400" height="400"
                                srcset="assets/images/optimized/team/nurse_safae_mobile_300x300.png 300w, assets/images/optimized/team/nurse_safae_desktop_400x400.png 400w"
                                sizes="(max-width: 768px) 300px, 400px" alt="Imarhrane Safae - Registered Nurse"
                                class="team-member__img" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <div class="team-member__info">
                            <h3 class="team-member__name">Mrs. Imarhrane Safae</h3>
                            <p class="team-member__title">Registered Nurse</p>
                            <div class="team-member__description">
                                <p>
                                    At the heart of Family Clinic, there is a person whose benevolent presence and
                                    exemplary
                                    professionalism illuminate each day: our nurse in charge of reception and care. She
                                    embodies
                                    the soul of our establishment, combining medical competence, attentive listening,
                                    and warm
                                    welcome.
                                </p>
                                <p>
                                    From the first contact, she knows how to reassure, guide, and care with rare
                                    gentleness.
                                    Her ability to manage emergencies while maintaining a serene atmosphere is
                                    admirable.
                                </p>
                                <p>
                                    Mrs. Safae Imarhrane is the pillar on which our patients' trust rests, and the
                                    indispensable
                                    support of our entire team. Her smile, always sincere, is often the first remedy
                                    received
                                    by those who cross our threshold. Her rigor in care, her availability, and her
                                    attention
                                    to detail make her an exceptional professional, but also a deeply human person.
                                </p>
                                <p>
                                    With her, the Family Clinic medical practice is not just a place of care, but a true
                                    refuge of compassion and excellence.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Values Section -->
        <section class="values">
            <div class="values__container">
                <h2 class="values__title">Our Values</h2>
                <div class="values__grid">
                    <div class="value-card">
                        <h3>Compassionate Care</h3>
                        <p>We believe in treating every patient with kindness, respect, and understanding, creating a
                            welcoming environment where families feel comfortable and supported.</p>
                    </div>
                    <div class="value-card">
                        <h3>Medical Excellence</h3>
                        <p>Our team combines traditional medical expertise with innovative approaches to provide the
                            highest quality healthcare services for all ages.</p>
                    </div>
                    <div class="value-card">
                        <h3>Holistic Approach</h3>
                        <p>We address the whole person - body, mind, and spirit - recognizing that true health
                            encompasses
                            all aspects of well-being.</p>
                    </div>
                    <div class="value-card">
                        <h3>Family-Centered</h3>
                        <p>We build lasting relationships with families, ensuring continuity of care and better health
                            outcomes through personalized attention.</p>
                    </div>
                </div>
            </div>
        </section>
        <!-- Call to action -->
        <section class="cta-band">
            <div class="cta-band__container">
                <h2 class="cta-band__title">Ready when you are.</h2>
                <p class="cta-band__text">Call to book your appointment — we answer during opening hours.</p>
                <a href="tel:{{ site.contact.phone }}" class="btn btn--primary">Call {{ site.contact.phone }}</a>
            </div>
        </section>
