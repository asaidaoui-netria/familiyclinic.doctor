---
layout: layouts/base.njk
locale: en
pageKey: contact
permalink: /contact.html
activeNav: contact
indexable: true
stylesheets: [styles.css, contact.css, localization.css]
scripts: [script.js, localization.js, contact.js]
title: "Contact Us - Family Clinic | Get in Touch"
description: "Contact Family Clinic for appointments, inquiries, or general questions in Kenitra, Morocco."
---

        <!-- Contact Hero Section -->
        <section class="contact-hero">
            <div class="container">
                <div class="contact-hero__content">
                    <h1 class="contact-hero__title">Get in Touch</h1>
                    <p class="contact-hero__description">
                        We're here to help you and your family. Contact us for appointments, questions, or to learn more
                        about our comprehensive healthcare services.
                    </p>
                </div>
            </div>
        </section>

        <!-- Notice Banner Section -->
        <!-- <section class="notice-banner" id="notice-banner">
            <div class="notice-banner__container">
                <div class="notice-banner__content">
                    <div class="notice-banner__text">
                        <h3 class="notice-banner__title">Important Notice</h3>
                        <p class="notice-banner__message">
                            The clinic will be closed from <strong>August 4</strong> until <strong>August 24</strong>
                            for annual summer holiday.
                        </p>
                    </div>

                </div>
            </div>
        </section> -->

        <!-- Contact Information Section -->
        <section class="contact-info">
            <div class="contact-info__container">
                {% include "contact-details.njk" %}
            </div>
        </section>

        <!-- Map Section -->
        <section class="map-section">
            <div class="map-section__container">
                <h3 class="map-section__title">Find Us</h3>
                <div class="map-section__content">
                    <div class="map-section__map">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d401.43216058873656!2d-6.621467983204455!3d34.26471722551217!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xda7590b1fc37cd3%3A0x7ce3ec2840772cca!2z2LnZitin2K_YqSDYp9mE2KPYs9ix2Kk!5e0!3m2!1sen!2sma!4v1754830762622!5m2!1sen!2sma"
                            width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade" title="Family Clinic Location Map">
                        </iframe>
                    </div>
                    <div class="map-section__info">
                        <h4 class="map-section__info-title">Getting Here</h4>
                        <p class="map-section__info-text">
                            We are located in the Ouled Oujih district of Kenitra, close to mosque Ar-Rayan, easily
                            accessible by car, public
                            transportation, or on foot.
                        </p>
                        <div class="map-section__directions">
                            <h5 class="map-section__directions-title">Directions</h5>
                            <ul class="map-section__directions-list">
                                <li>From Kenitra Train Station: 14-minute drive</li>
                                <li>Public Bus: Lines 5, 12, 14, and 16</li>
                                <li>Parking: Free street parking. Limited space available.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="faq-section">
            <div class="faq-section__container">
                <h3 class="faq-section__title">Frequently Asked Questions</h3>
                <div class="faq-section__list">
                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            How do I book an appointment?
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>You can book an appointment by calling us at {{ site.contact.phone }}, or visiting us in person
                                during our opening hours.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            What documents should I bring to my first visit?
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>Please bring your ID, any previous medical records, current medications list, and
                                insurance information if applicable.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            Do you accept walk-in patients?
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>Yes, we accept walk-in patients. However, we recommend booking an appointment to ensure
                                availability.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            What languages do you speak?
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>Our team speaks English, French, and Arabic to ensure clear communication with all our
                                patients.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            Is parking available?
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>Yes, we have free street parking available. Please note that parking is limited and may
                                be subject to availability.</p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-item__question" aria-expanded="false">
                            is the clinic wheelchair accessible?
                            <span class="faq-item__icon">+</span>
                        </button>
                        <div class="faq-item__answer">
                            <p>Yes, the clinic is wheelchair accessible.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
