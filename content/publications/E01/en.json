    {
      "type": "list",
      "ordered": false,
      "items": [
        "Energy.",
        "Mood.",
        "Immunity.",
        "Sleep.",
        "Aging.",
        "Inflammatory mechanisms."
      ],
      "levels": [
        0,
        0,
        0,
        0,
        0,
        0
      ]
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Family Clinic dietary basics"
    },
    {
      "type": "paragraph",
      "text": "Favor:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "A variety of vegetables.",
        "Fresh fruit.",
        "Legumes.",
        "Fish.",
        "Eggs.",
        "Nuts and seeds.",
        "Good-quality olive oils.",
        "Minimally processed foods."
      ],
      "levels": [
        0,
